{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/TDP-ops/tdp-ai-handoff-integrity-monitor/blob/main/schemas/handoff-v0.schema.json",
  "title": "AI Handoff Integrity Monitor - V0 canonical contract",
  "description": "Data contract only; cross-record integrity, actual receiver access and authorization require runtime checks.",
  "oneOf": [
    {
      "$ref": "#/$defs/run_plan"
    },
    {
      "$ref": "#/$defs/event"
    },
    {
      "$ref": "#/$defs/finding"
    }
  ],
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "artifact_version_id",
        "kind",
        "required",
        "observation"
      ],
      "properties": {
        "artifact_id": {
          "$ref": "#/$defs/identifier"
        },
        "artifact_version_id": {
          "$ref": "#/$defs/identifier"
        },
        "kind": {
          "enum": [
            "text",
            "image",
            "pdf",
            "docx",
            "audio",
            "csv",
            "xlsx",
            "db_schema",
            "json",
            "yaml",
            "other"
          ]
        },
        "name": {
          "type": "string",
          "maxLength": 512
        },
        "uri": {
          "type": "string",
          "maxLength": 4096
        },
        "required": {
          "type": "boolean"
        },
        "content_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "mime_type": {
          "type": "string",
          "maxLength": 128
        },
        "parent_version_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/identifier"
          },
          "uniqueItems": true,
          "default": []
        },
        "derived_from_artifact_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/identifier"
          },
          "uniqueItems": true,
          "default": []
        },
        "replaces_artifact_id": {
          "$ref": "#/$defs/identifier"
        },
        "observation": {
          "$ref": "#/$defs/observation"
        },
        "checks": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "exact_bytes": {
              "type": "boolean"
            },
            "required_structure": {
              "type": "object"
            },
            "quality_invariants": {
              "type": "object"
            }
          }
        }
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "access"
      ],
      "properties": {
        "source": {
          "enum": [
            "sender",
            "receiver",
            "filesystem_probe",
            "extractor",
            "external_observer"
          ]
        },
        "access": {
          "enum": [
            "verified",
            "not_accessible",
            "not_checked",
            "unavailable"
          ]
        },
        "observed_at": {
          "type": "string",
          "format": "date-time"
        },
        "evidence_ref": {
          "type": "string",
          "maxLength": 512
        },
        "hash_computed_from_bytes": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_id",
        "version",
        "from_step",
        "to_step",
        "required_artifact_ids",
        "accepted_versions",
        "required_rule_ids",
        "allowed_transforms",
        "allowed_lifecycle_events"
      ],
      "properties": {
        "contract_id": {
          "$ref": "#/$defs/identifier"
        },
        "version": {
          "$ref": "#/$defs/identifier"
        },
        "from_step": {
          "$ref": "#/$defs/identifier"
        },
        "to_step": {
          "$ref": "#/$defs/identifier"
        },
        "required_artifact_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/identifier"
          },
          "uniqueItems": true
        },
        "accepted_versions": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/identifier"
            },
            "uniqueItems": true
          }
        },
        "required_rule_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/identifier"
          },
          "uniqueItems": true
        },
        "allowed_transforms": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "allowed_lifecycle_events": {
          "type": "array",
          "items": {
            "enum": [
              "created",
              "transmitted",
              "received",
              "modified",
              "rejected",
              "replaced",
              "retired"
            ]
          },
          "uniqueItems": true
        },
        "allowed_replacements": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/identifier"
          },
          "uniqueItems": true,
          "default": []
        }
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_id",
        "run_id",
        "handoff_id",
        "from_step",
        "to_step",
        "contract_id",
        "contract_version",
        "manifest_role",
        "artifacts",
        "rule_ids"
      ],
      "properties": {
        "event_id": {
          "$ref": "#/$defs/identifier"
        },
        "run_id": {
          "$ref": "#/$defs/identifier"
        },
        "handoff_id": {
          "$ref": "#/$defs/identifier"
        },
        "from_step": {
          "$ref": "#/$defs/identifier"
        },
        "to_step": {
          "$ref": "#/$defs/identifier"
        },
        "contract_id": {
          "$ref": "#/$defs/identifier"
        },
        "contract_version": {
          "$ref": "#/$defs/identifier"
        },
        "manifest_role": {
          "enum": [
            "sent",
            "received"
          ]
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "artifacts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/artifact"
          }
        },
        "rule_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/identifier"
          },
          "uniqueItems": true
        },
        "lifecycle_events": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/lifecycle"
          }
        }
      }
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_id",
        "artifact_id",
        "event_type",
        "step_id",
        "authorized_by_policy"
      ],
      "properties": {
        "event_id": {
          "$ref": "#/$defs/identifier"
        },
        "artifact_id": {
          "$ref": "#/$defs/identifier"
        },
        "artifact_version_id": {
          "$ref": "#/$defs/identifier"
        },
        "event_type": {
          "enum": [
            "created",
            "transmitted",
            "received",
            "modified",
            "rejected",
            "replaced",
            "retired"
          ]
        },
        "step_id": {
          "$ref": "#/$defs/identifier"
        },
        "reason": {
          "type": "string",
          "maxLength": 2048
        },
        "replaces_artifact_id": {
          "$ref": "#/$defs/identifier"
        },
        "authorized_by_policy": {
          "type": "boolean"
        },
        "policy_ref": {
          "type": "string",
          "maxLength": 512
        }
      }
    },
    "run_plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_id",
        "plan_version",
        "steps",
        "contracts",
        "critical_rule_ids"
      ],
      "properties": {
        "run_id": {
          "$ref": "#/$defs/identifier"
        },
        "plan_version": {
          "$ref": "#/$defs/identifier"
        },
        "steps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/identifier"
          },
          "uniqueItems": true
        },
        "contracts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/contract"
          }
        },
        "critical_rule_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/identifier"
          },
          "uniqueItems": true
        },
        "source_baseline_refs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "finding_id",
        "handoff_id",
        "code",
        "verdict",
        "evidence_status"
      ],
      "properties": {
        "finding_id": {
          "$ref": "#/$defs/identifier"
        },
        "handoff_id": {
          "$ref": "#/$defs/identifier"
        },
        "artifact_id": {
          "$ref": "#/$defs/identifier"
        },
        "code": {
          "type": "string",
          "minLength": 1
        },
        "verdict": {
          "enum": [
            "PASS",
            "ALERT",
            "UNKNOWN",
            "BLOCK"
          ]
        },
        "evidence_status": {
          "enum": [
            "observed",
            "partial",
            "unavailable"
          ]
        },
        "explanation": {
          "type": "string"
        },
        "recommended_action": {
          "type": "string"
        }
      }
    }
  }
}
